generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum BatchStatus {
  PENDING_DOCUMENTATION
  PENDING_INDEPENDENT_TESTING
  APPROVED
  ACTIVE
  HOLD
  DEPLETED
  RECALLED
  ARCHIVED
}

enum TestingStatus {
  NOT_STARTED
  MANUFACTURER_DOCUMENTED
  INDEPENDENT_PENDING
  INDEPENDENT_VERIFIED
  REVIEW_REQUIRED
}

enum DocumentType {
  MANUFACTURER_COA
  INDEPENDENT_COA
  IDENTITY_TEST
  PURITY_TEST
  OTHER
}

enum InventoryTransactionType {
  RECEIVED
  RESERVED
  RESERVATION_RELEASED
  FULFILLED
  DAMAGED
  LOST
  RETURNED
  QUARANTINED
  MANUAL_ADJUSTMENT
}

enum LotAssignmentStatus {
  RESERVED
  ASSIGNED
  FULFILLED
  CORRECTED
  RELEASED
}

model Product {
  id                   String   @id @default(cuid())
  shopifyProductId     String   @unique
  shopifyVariantId     String?  @unique
  sku                  String?
  name                 String
  strengthValue        Decimal? @db.Decimal(12, 3)
  strengthUnit         String?
  lotCode              String   @unique
  vialTemplate         String?
  batchTrackingEnabled Boolean  @default(true)
  active               Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  manufacturerBatches ManufacturerBatch[]
  psBatches           PsBatch[]
  lotSequences        BatchLotSequence[]
  lotAssignments      OrderLotAssignment[]
}

model Supplier {
  id          String   @id @default(cuid())
  name        String
  contactName String?
  email       String?
  phone       String?
  country     String?
  status      String   @default("ACTIVE")
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  shipments   Shipment[]
}

model Shipment {
  id                  String   @id @default(cuid())
  supplierId          String
  purchaseOrderNumber String?
  shipmentReference   String?
  trackingNumber      String?
  receivedDate        DateTime?
  receivedByUserId    String?
  inspectionStatus    String   @default("PENDING")
  notes               String?
  createdAt            DateTime @default(now())

  supplier            Supplier @relation(fields: [supplierId], references: [id])
  manufacturerBatches ManufacturerBatch[]
}

model ManufacturerBatch {
  id                     String   @id @default(cuid())
  shipmentId             String?
  productId              String
  manufacturerLotNumber  String
  quantityReceived       Int
  manufactureDate        DateTime?
  expirationOrRetestDate DateTime?
  createdAt              DateTime @default(now())

  shipment  Shipment? @relation(fields: [shipmentId], references: [id])
  product   Product   @relation(fields: [productId], references: [id])
  psBatches PsBatch[]

  @@unique([productId, manufacturerLotNumber])
}

model PsBatch {
  id                    String        @id @default(cuid())
  productId             String
  manufacturerBatchId   String
  psLotNumber           String        @unique
  batchStatus           BatchStatus   @default(PENDING_DOCUMENTATION)
  testingStatus         TestingStatus @default(NOT_STARTED)
  quantityReceived      Int
  quantityReserved      Int           @default(0)
  quantityFulfilled     Int           @default(0)
  quantityAdjusted      Int           @default(0)
  quantityQuarantined   Int           @default(0)
  quantityAvailable     Int
  receivedDate          DateTime?
  activatedAt           DateTime?
  depletedAt            DateTime?
  holdReason            String?
  recalledReason        String?
  recalledAt            DateTime?
  createdByUserId       String
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  product               Product                @relation(fields: [productId], references: [id])
  manufacturerBatch     ManufacturerBatch      @relation(fields: [manufacturerBatchId], references: [id])
  documents             BatchDocument[]
  qrCodes               BatchQrCode[]
  lotAssignments        OrderLotAssignment[]
  inventoryTransactions InventoryTransaction[]
  auditEvents           AuditEvent[]

  @@index([productId, batchStatus])
  @@index([batchStatus, testingStatus])
}

model BatchLotSequence {
  id        String   @id @default(cuid())
  productId String
  lotDate   DateTime @db.Date
  lastValue Int      @default(0)
  product   Product  @relation(fields: [productId], references: [id])

  @@unique([productId, lotDate])
}

model BatchDocument {
  id              String       @id @default(cuid())
  psBatchId       String
  documentType    DocumentType
  versionNumber   Int
  laboratoryName  String?
  testDate        DateTime?
  purityResult    Decimal?     @db.Decimal(8, 4)
  identityResult  String?
  storageUrl      String
  fileName        String
  mimeType        String?
  fileSizeBytes   Int?
  publicVisible   Boolean      @default(false)
  approved        Boolean      @default(false)
  approvedBy      String?
  approvedAt      DateTime?
  supersededAt    DateTime?
  createdBy       String
  createdAt       DateTime     @default(now())

  psBatch PsBatch @relation(fields: [psBatchId], references: [id])

  @@unique([psBatchId, documentType, versionNumber])
  @@index([psBatchId, documentType, approved])
}

model BatchQrCode {
  id                String   @id @default(cuid())
  psBatchId         String
  verificationToken String   @unique
  verificationUrl   String
  active            Boolean  @default(true)
  createdAt         DateTime @default(now())
  revokedAt         DateTime?

  psBatch PsBatch @relation(fields: [psBatchId], references: [id])

  @@index([psBatchId, active])
}

model OrderLotAssignment {
  id                  String              @id @default(cuid())
  shopifyOrderId      String
  shopifyOrderLineId  String
  productId           String
  psBatchId           String
  quantity            Int
  quantityReturned    Int                 @default(0)
  status              LotAssignmentStatus @default(RESERVED)
  assignedBy          String
  assignedAt          DateTime             @default(now())
  fulfilledAt         DateTime?
  correctedFromId     String?
  correctionReason    String?
  createdAt           DateTime             @default(now())

  product Product @relation(fields: [productId], references: [id])
  psBatch PsBatch @relation(fields: [psBatchId], references: [id])

  @@index([shopifyOrderId, shopifyOrderLineId])
  @@index([psBatchId, status])
}

model InventoryTransaction {
  id              String                   @id @default(cuid())
  psBatchId       String
  transactionType InventoryTransactionType
  quantity        Int
  orderId         String?
  orderLineId     String?
  reason          String?
  notes           String?
  createdBy       String
  createdAt       DateTime                 @default(now())

  psBatch PsBatch @relation(fields: [psBatchId], references: [id])
}

model AuditEvent {
  id           String   @id @default(cuid())
  userId       String
  entityType   String
  entityId     String
  action       String
  oldValueJson Json?
  newValueJson Json?
  reason       String?
  ipAddress    String?
  createdAt    DateTime @default(now())

  psBatchId String?
  psBatch   PsBatch? @relation(fields: [psBatchId], references: [id])
}

model WebhookEvent {
  id            String   @id @default(cuid())
  shopifyEventId String   @unique
  topic         String
  shopDomain    String?
  payloadHash   String?
  status        String   @default("RECEIVED")
  errorMessage  String?
  processedAt   DateTime?
  createdAt     DateTime @default(now())

  @@index([topic, status])
}

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/peptide_society"
PUBLIC_VERIFY_BASE_URL="https://peptidesociety.com/pages/verify-batch"
APP_BASE_URL="https://batch.peptidesociety.com"

# Local development only
DOCUMENT_STORAGE_MODE="local"
DOCUMENT_STORAGE_DIR="./storage/batch-documents"
ALLOW_LOCAL_DOCUMENT_STORAGE="false"

# Production durable private object storage (AWS S3, R2 S3-compatible, etc.)
# DOCUMENT_STORAGE_MODE="s3"
DOCUMENT_S3_BUCKET=""
DOCUMENT_S3_REGION="us-east-1"
DOCUMENT_S3_ENDPOINT=""
DOCUMENT_S3_FORCE_PATH_STYLE="false"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""

SHOPIFY_SHOP="your-store.myshopify.com"
SHOPIFY_ADMIN_ACCESS_TOKEN="shpat_replace_me"
SHOPIFY_API_VERSION="2026-07"
SHOPIFY_WEBHOOK_SECRET="replace_me"

# Admin write-route authentication. Use a long random secret; never expose client-side.
PS_ADMIN_API_KEY="replace_with_32_plus_random_bytes"
# Optional display identity supplied by trusted admin clients in x-ps-admin-user.

# Storefront origins allowed to call public verification from browser JavaScript.
# Comma-separate if preview/custom domains both need access.
PUBLIC_STOREFRONT_ORIGINS="https://kkwzpp-e1.myshopify.com"
